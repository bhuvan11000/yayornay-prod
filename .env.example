# Supabase (frontend — safe to expose, RLS protects data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Supabase (backend — NEVER expose, set in Netlify dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# Gemini (backend only)
GEMINI_API_KEY=AIza...

# Admin email (frontend — admin panel access check)
VITE_ADMIN_EMAIL=admin@example.com

# Admin email (backend — admin API endpoint verification)
ADMIN_EMAIL=admin@example.com

# Cron auth (backend only)
CRON_SECRET=random-secret-string-for-cron-auth
